{
  "name": "gerrymander-vite",
  "version": "0.2.0",
  "description": "Zero-config Vite integration for the gerrymander dev proxy: hostnames, sticky ports, TLS and HMR from your gerrymander.yaml — just run vite.",
  "main": "index.cjs",
  "types": "index.d.ts",
  "files": [
    "index.cjs",
    "index.d.ts",
    "README.md"
  ],
  "peerDependencies": {
    "vite": ">=5"
  },
  "license": "MIT",
  "repository": "github:Nano112/gerrymander",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.cjs",
      "import": "./index.cjs"
    }
  }
}